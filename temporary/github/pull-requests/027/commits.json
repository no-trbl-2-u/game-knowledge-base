[{"sha":"33f48e9fbe7db45649eb0f5812179b1d2765c62c","node_id":"C_kwDOTNzNAtoAKDMzZjQ4ZTlmYmU3ZGI0NTY0OWViMGY1ODEyMTc5YjFkMjc2NWM2MmM","commit":{"author":{"name":"TJ","email":"no.trbl.2.u@gmail.com","date":"2026-08-01T08:29:13Z"},"committer":{"name":"TJ","email":"no.trbl.2.u@gmail.com","date":"2026-08-01T08:29:13Z"},"message":"kb: make intake gate scripts runnable on Windows\n\n- Resolve script-relative paths with fileURLToPath instead of URL.pathname,\n  which yields /C:/... and breaks every git spawn on Windows (same fix the\n  index/sidecar generators already carry).\n- Force lossy VP8 webp in test fixtures: ffmpeg 8 auto-picks lossless VP8X\n  for flat lavfi sources and its native decoder cannot read those back.\n- Give fail-closed a Windows-spawnable .cmd hermes shim (shell only on\n  win32; POSIX spawn unchanged) and set USERPROFILE alongside HOME.\n- Probe symlink capability and skip the two symlink-escape tests where\n  creation is denied (Windows without Developer Mode); Linux CI still\n  exercises both gates.","tree":{"sha":"3bf0a9a8a93fa5267688b1cee82688836fe04817","url":"https://api.github.com/repos/no-trbl-2-u/game-knowledge-base/git/trees/3bf0a9a8a93fa5267688b1cee82688836fe04817"},"url":"https://api.github.com/repos/no-trbl-2-u/game-knowledge-base/git/commits/33f48e9fbe7db45649eb0f5812179b1d2765c62c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/no-trbl-2-u/game-knowledge-base/commits/33f48e9fbe7db45649eb0f5812179b1d2765c62c","html_url":"https://github.com/no-trbl-2-u/game-knowledge-base/commit/33f48e9fbe7db45649eb0f5812179b1d2765c62c","comments_url":"https://api.github.com/repos/no-trbl-2-u/game-knowledge-base/commits/33f48e9fbe7db45649eb0f5812179b1d2765c62c/comments","author":{"login":"no-trbl-2-u","id":40865735,"node_id":"MDQ6VXNlcjQwODY1NzM1","avatar_url":"https://avatars.githubusercontent.com/u/40865735?v=4","gravatar_id":"","url":"https